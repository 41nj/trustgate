# Copy to .env (git-ignored), fill in, then load before starting TrustGate:
#   set -a; source .env; set +a; python3 app.py
# Placeholders only. Never commit real endpoints or keys.
TRUSTGATE_API_BASE=https://api.example.com/v1
TRUSTGATE_MODEL=provider/model-id
TRUSTGATE_API_KEY=replace-me
# Alternatively, read the key from a private file outside the repository:
# TRUSTGATE_API_KEY_FILE=~/.config/trustgate/keys.env
# TRUSTGATE_API_KEY_NAME=KEY_1
# TRUSTGATE_TEMPERATURE=0
# TRUSTGATE_MAX_TOKENS=4096
